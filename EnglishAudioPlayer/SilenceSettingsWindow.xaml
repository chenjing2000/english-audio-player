<Window x:Class="AudioPausePlayer.SilenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="停顿检测设置"
        Width="324" Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="分析帧长度（ms）" VerticalAlignment="Center" Margin="0,0,16,14"/>
        <TextBox x:Name="FrameMillisecondsTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" Padding="6,4"
                 PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput" DataObject.Pasting="PositiveIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="1" Text="最短停顿时长（ms）" VerticalAlignment="Center" Margin="0,0,16,14"/>
        <TextBox x:Name="MinimumSilenceTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" Padding="6,4"
                 PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput" DataObject.Pasting="PositiveIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="2" Text="静音阈值（dBFS）" VerticalAlignment="Center" Margin="0,0,16,14"/>
        <TextBox x:Name="SilenceThresholdTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" Padding="6,4"
                 PreviewTextInput="SignedIntegerTextBox_PreviewTextInput" DataObject.Pasting="SignedIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="3" Text="前后跳转容差（ms）" VerticalAlignment="Center" Margin="0,0,16,14"/>
        <TextBox x:Name="NavigationToleranceTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="3" Grid.Column="1" Margin="0,0,0,14" Padding="6,4"
                 PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput" DataObject.Pasting="PositiveIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Foreground="#6B7280" TextWrapping="Wrap"
                   Text="默认值：10 ms、300 ms、-45 dBFS、200 ms。参数修改后，当前已加载音频会重新分析停顿位置。"/>

        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RestoreDefaultsButton" Width="76" Height="32" Padding="4,2" Content="恢复默认" Click="RestoreDefaultsButton_Click"/>
            <Button x:Name="CancelButton" Grid.Column="2" Width="54" Height="32" Padding="4,2" Margin="0,0,10,0" Content="取消" IsCancel="True"/>
            <Button x:Name="OkButton" Grid.Column="3" Width="54" Height="32" Padding="4,2" Content="确定" IsDefault="True" Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
